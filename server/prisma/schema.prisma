// Mapped onto the tables the JS version made with raw SQL (models/initdb.js,
// initPrices.js, migrate.js), so an existing database is used as it is:
// run `npm run db:baseline` once against it instead of migrating.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- the shelf ----------

model User {
  id                 Int                @id @default(autoincrement())
  username           String             @unique @db.VarChar(40)
  // when the account was made: a reader's reports of missing edition books
  // count only once it's a week old (util/shelf/editionReports.ts). Accounts
  // made before this was kept carry the day it was added
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  // missing for an account made with Google, until they set one in Settings
  password           String?
  // the Google account they sign in with (Google's "sub"): never its email
  // or name, which aren't kept
  googleId           String?            @unique @map("google_id") @db.VarChar(64)
  // the Apple account they sign in with (Apple's "sub" for this app)
  appleId            String?            @unique @map("apple_id") @db.VarChar(64)
  // display preferences: { background, theme }
  prefs              Json               @default("{}")
  // what others see if they share their list; the username stays private
  displayName        String?            @map("display_name") @db.VarChar(40)
  avatar             String?            @db.VarChar(20)
  // optional, given on signing up or in settings. The account's one email: a
  // password reset link is sent to it. Saved in lowercase, one account each
  recoveryEmail      String?            @unique @map("recovery_email") @db.VarChar(254)
  // the link is a random code, and stays the same if sharing is switched off and on
  shareEnabled       Boolean            @default(false) @map("share_enabled")
  shareNotes         Boolean            @default(false) @map("share_notes")
  // on a shared shelf: their star ratings, and how far they've read. Shown
  // unless they switch them off
  shareRatings       Boolean            @default(true) @map("share_ratings")
  shareProgress      Boolean            @default(true) @map("share_progress")
  shareCode          String?            @unique @map("share_code") @db.VarChar(16)
  // series on their shelf, kept right by a database trigger on manga
  // (migration 20261113000000_search_tracking); never written from code
  mangaCount         Int                @default(0) @map("manga_count")
  // The Collector tier (src/plan/planRules.ts). "free"; "collector", paid
  // for until planUntil; or "early", an account made before the tier
  // existed, which is never limited. scansUsed: barcodes they've scanned
  plan               String             @default("free") @db.VarChar(12)
  planUntil          DateTime?          @map("plan_until") @db.Timestamptz(6)
  scansUsed          Int                @default(0) @map("scans_used")
  // the App Store subscription behind a Collector plan (its original
  // transaction ID): renewals and refunds Apple sends find the account by it
  appleSubscription  String?            @unique @map("apple_subscription") @db.VarChar(64)
  // for the member card: when they first became a Collector, the product
  // they pay for (collector.yearly or collector.monthly), and whether Apple
  // will renew it (false once they cancel; the plan still runs to planUntil)
  collectorSince     DateTime?          @map("collector_since") @db.Timestamptz(6)
  appleProduct       String?            @map("apple_product") @db.VarChar(64)
  planRenews         Boolean?           @map("plan_renews")
  // SerpApi searches their visits have spent (prices/spender.ts)
  serpapiSearches    Int                @default(0) @map("serpapi_searches")
  // when they were last asked out loud about a volume they'd just finished
  // (reviews/reviews.ts askAboutFinishedVolume); it's asked rarely
  rateAskedAt        DateTime?          @map("rate_asked_at") @db.Timestamptz(6)
  manga              Manga[]
  editionReports     EditionReport[]
  reviews            VolumeReview[]
  reviewFlags        ReviewFlag[]
  importPicks        ImportPick[]
  toBuy              ToBuy[]
  bookVolumes        BookVolumeAnswer[]
  isbnSightings      IsbnSighting[]
  // a password reset link's token, as its hash (util/resetToken.ts)
  reset_token        String?            @unique
  reset_token_expiry BigInt? // in milliseconds
  // The weekly email (src/digest/). Asked for in settings, and only sent
  // once the address has been confirmed from a link mailed to it. emailCode
  // is the random code in that link and in every unsubscribe link; a new
  // address gets a new one. digestSentAt: when their last one went out
  weeklyEmail        Boolean            @default(false) @map("weekly_email")
  emailConfirmed     Boolean            @default(false) @map("email_confirmed")
  emailCode          String?            @unique @map("email_code") @db.VarChar(40)
  digestSentAt       DateTime?          @map("digest_sent_at") @db.Timestamptz(6)
  digestItems        DigestItem[]
  pushSubscriptions  PushSubscription[]
  shelfEvents        ShelfEvent[]
  // shared shelves they follow, and who follows theirs (ShelfFollow)
  following          ShelfFollow[]      @relation("follower")
  followers          ShelfFollow[]      @relation("followed")
  // readers they've blocked, and who has blocked them (UserBlock)
  blocking           UserBlock[]        @relation("blocker")
  blockedBy          UserBlock[]        @relation("blocked")

  @@map("users")
}

// a device that switched on alerts (src/push/): its push service's address
// and the keys to encrypt for it
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// what a reader has been emailed about, so nothing is sent twice
// (src/digest/digestRules.ts names the items)
model DigestItem {
  userId Int      @map("user_id")
  item   String   @db.VarChar(80)
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, item])
  @@map("digest_items")
}

model Manga {
  id              Int       @id @default(autoincrement())
  userId          Int?      @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name            String
  genre           String?   @db.VarChar(100)
  description     String?
  image           String?
  // true = finished reading
  status          Boolean   @default(false)
  // on their To read list: not started yet. Never true alongside status
  planned         Boolean   @default(false)
  // a light novel rather than a manga: no manga prices or volume news for it
  lightNovel      Boolean   @default(false) @map("light_novel")
  // the chapter they're on
  bookmark        Int?
  // how they keep their place: by the volume (true) or the chapter. Light
  // novels start by the volume
  byVolume        Boolean   @default(false) @map("by_volume")
  // the last volume they've read; apart from the ones they own
  readVolume      Int?      @map("read_volume") @db.SmallInt
  // when its page started asking about the volume they'd just finished
  // (reviews/reviews.ts askAboutFinishedVolume); null when it isn't asking
  readVolumeAt    DateTime? @map("read_volume_at") @db.Timestamptz(6)
  // the edition they collect ("deluxe", "3in1": prices/editionLines.ts), so
  // what to buy next is in that edition's books; null is single volumes
  edition         String?   @db.VarChar(20)
  // the last volume they own ("up to Vol. 14"); null when they don't say
  volumesOwned    Int?      @map("volumes_owned") @db.SmallInt
  // the exact volumes they own, when it isn't a run from 1 (One Piece 1 and 4);
  // empty means 1 to volumesOwned. volumesOwned is its highest
  // (util/shelf/ownedList.ts)
  ownedList       Float[]   @default([]) @map("owned_list")
  // ordered, not here yet: Buy next goes past them; owning one takes it off
  // (migration 20261210000000_ordered_and_lent)
  orderedList     Float[]   @default([]) @map("ordered_list")
  rating          Int?      @db.SmallInt
  // the newest release they've said "Seen it" to; anything newer shows as new
  seenVolume      Float?    @map("seen_volume")
  seenChapter     Float?    @map("seen_chapter")
  seenJapanVolume Float?    @map("seen_japan_volume")
  // volumes hidden one at a time, on top of everything up to seenVolume
  hiddenVolumes   Float[]   @default([]) @map("hidden_volumes")
  // the latest chapter last found for this series; updated by each lookup
  latestChapter   Float?    @map("latest_chapter")
  // when the reader last changed it (their place, what they own, a rating,
  // notes, where it sits on the shelf): the shelf's "Last updated" order. Set
  // by hand in models/mangaQueries.ts, so a release check or a hidden card
  // doesn't move a series up
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  // the last release check's answer, so the New tab can open without asking
  // every other site again (ReleaseAnswer)
  releaseAnswer ReleaseAnswer?
  // the books behind the volumes they own (OwnedBook)
  books         OwnedBook[]
  // its dated history (ShelfEvent), written by the database
  events        ShelfEvent[]

  @@index([userId])
  @@map("manga")
}

// One book they own of a series: "Berserk Deluxe 2" holds vols 4 to 6. Written
// by a barcode scan or an import, which know the ISBN; a volume ticked by hand
// has no book. Every book's volumes are owned on its manga: one that isn't any
// more is dropped the next time the books are read (models/bookQueries.ts)
model OwnedBook {
  id        Int       @id @default(autoincrement())
  mangaId   Int       @map("manga_id")
  manga     Manga     @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  isbn13    String?   @db.VarChar(13)
  // single, omnibus, deluxe or boxset (util/shelf/ownedBooks.ts)
  edition   String    @default("single") @db.VarChar(12)
  // its number in that edition: Deluxe 2
  number    Float?
  title     String?   @db.VarChar(200)
  // the series' volumes it holds
  volumes   Float[]   @default([])
  // what they paid for it, in cents, and the day they bought it: both theirs
  // to say, for "spent so far"
  paidCents Int?      @map("paid_cents")
  boughtOn  DateTime? @map("bought_on") @db.Date
  // lent out: who has it, and since when
  lentTo    String?   @map("lent_to") @db.VarChar(40)
  lentOn    DateTime? @map("lent_on") @db.Date

  @@index([mangaId])
  @@map("owned_books")
}

// express-session's store (connect-pg-simple). Kept in the schema so
// migrations never try to drop it
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------- the price checker ----------

model Book {
  isbn13       String             @id @db.Char(13)
  title        String
  authors      String?
  publisher    String?
  coverUrl     String?            @map("cover_url")
  year         Int?               @db.SmallInt
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  // when a person last opened its page, never a search engine: the
  // background keeps these volumes' prices fresh first (collector/filler.ts)
  openedAt     DateTime?          @map("opened_at") @db.Timestamptz(6)
  samples      PriceSample[]
  check        PriceCheck?
  // each price source group's last look (prices/service.ts)
  sourceChecks PriceSourceCheck[]

  @@index([openedAt])
  @@map("books")
}

// every price we ever fetch, so we can show the latest offers and the history
model PriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  book       Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("USD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  // the source group that found it: ebay, shopping, amazon, ebooks, walmart
  source     String?  @db.VarChar(20)

  @@index([isbn13, fetchedAt(sort: Desc)], map: "price_samples_isbn_time")
  // the About page's count reads by time alone
  @@index([fetchedAt])
  @@map("price_samples")
}

// when each volume was last checked, even if no store had it
model PriceCheck {
  isbn13    String   @id @db.Char(13)
  book      Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("price_checks")
}

// each source group's last look at a volume; its prices are the samples it
// saved at that moment. Each group checks on its own schedule
model PriceSourceCheck {
  isbn13    String   @db.Char(13)
  book      Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  source    String   @db.VarChar(20)
  checkedAt DateTime @map("checked_at") @db.Timestamptz(6)

  @@id([isbn13, source])
  @@map("price_source_checks")
}

// AniList series info, cached a week per series
model SeriesInfo {
  slug      String   @id @db.VarChar(80)
  info      Json?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_info")
}

// a series' scores from outside AniList's average, out of 100: MyAnimeList's
// (shown first), MangaUpdates' (asked only when a series has neither that
// nor an AniList average) and AniList's plain mean, the last resort. Filled in the background (collector/scoreFiller.ts). A
// null is an answer too: no MyAnimeList entry, or too few raters there
model SeriesScore {
  anilistId Int      @id @map("anilist_id")
  malId     Int?     @map("mal_id")
  malScore  Int?     @map("mal_score")
  malRaters Int?     @map("mal_raters")
  muScore   Int?     @map("mu_score")
  muRaters  Int?     @map("mu_raters")
  meanScore Int?     @map("mean_score")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("series_scores")
}

// the last good list of a series' volumes, so a restart or an Open Library outage
// doesn't empty the page. Keyed by the normalized series name
model SeriesVolumes {
  key       String   @id @db.VarChar(200)
  volumes   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_volumes")
}

// whether a manga's series has a light novel in the catalog that AniList doesn't
// list (Solo Leveling's): checked in the background the first time the series
// comes up in a search, then again after a month (see prices/novelFinder.ts).
// Keyed like series_volumes, by the normalized series name
model NovelCheck {
  key       String   @id @db.VarChar(200)
  // the novel's series name as the catalog sells it, which can differ from
  // the manga's ("Omniscient Reader's Viewpoint Light Novel" for Omniscient
  // Reader); null when there's no novel
  name      String?  @db.VarChar(200)
  // how many novel volumes were found; 0 when there's no novel
  volumes   Int      @default(0)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("novel_checks")
}

// what an imported book title is on AniList, shared by everyone's imports so
// each one is faster than the last (util/shelf/sharedMatches.ts). Only real
// matches, each checked by the server against AniList before it's kept; the
// title is kept only as a hash. Filled ahead too (scripts/seedImportMatches.ts)
model ImportMatch {
  // sha256 of the search as the import asks it: format, exact-only, title
  key       String   @id @db.Char(64)
  anilistId Int      @map("anilist_id")
  malId     Int?     @map("mal_id")
  name      String   @db.VarChar(300)
  cover     String?
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("import_matches")
}

// a series a reader picked by hand for a title in their import (Edit on a
// row): theirs on every later import, on any device. When three readers pick
// the same series for the same title it becomes a shared match
// (import_matches) for everyone (util/shelf/importPicks.ts)
model ImportPick {
  userId    Int      @map("user_id")
  // sha256 of the search, as import_matches keys it (matchRule.ts matchKey)
  key       String   @db.Char(64)
  anilistId Int      @map("anilist_id")
  malId     Int?     @map("mal_id")
  name      String   @db.VarChar(300)
  cover     String?
  pickedAt  DateTime @default(now()) @map("picked_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([key, anilistId])
  @@map("import_picks")
}

// what a reader said a book holds, for an edition the app couldn't work out
// ("Which volumes are in this book?"): theirs at once, and everyone's once
// three readers say the same (util/shelf/bookVolumeAnswers.ts)
model BookVolumeAnswer {
  userId     Int      @map("user_id")
  isbn13     String   @db.Char(13)
  volumes    Float[]
  answeredAt DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, isbn13])
  @@index([isbn13])
  @@map("book_volume_answers")
}

// a volume on a reader's To buy list: one they looked up and mean to buy
// (toBuy/toBuy.ts). Its prices are read from what's stored, never kept here
model ToBuy {
  userId     Int      @map("user_id")
  isbn13     String   @db.Char(13)
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  // their own note on it, and where it sits in their own order (null until
  // they first move one; migration 20261215000000_to_buy_note_and_order)
  note       String?  @db.VarChar(140)
  position   Int?
  // the price they asked to be told at (an alert when a copy is at or under it)
  alertCents Int?     @map("alert_cents")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, isbn13])
  @@map("to_buy")
}

// a manga's last release check, as its answer was sent: the New tab asks for
// a whole shelf of these at once rather than one site call per series. Kept
// only while key (what the answer depended on: the series, how far they are,
// what they've hidden, their release settings) still matches, and for hours
model ReleaseAnswer {
  mangaId   Int      @id @map("manga_id")
  key       String
  answer    Json
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@map("release_answers")
}

// what MangaDex said about a series' releases, kept 6 hours (util/releaseCache.ts)
model ReleaseDates {
  slug      String   @id @db.VarChar(160)
  data      Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("release_dates")
}

// paid APIs with a monthly allowance: how many calls we've made this month
// SerpApi searches spent by visitors who aren't signed in, one row per
// visitor a month. visitor hashes their IP and browser with the server
// secret; no IP is stored (prices/spender.ts)
model GuestSearch {
  visitor   String   @db.Char(16)
  month     DateTime @db.Date
  searches  Int      @default(0)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  lastAt    DateTime @default(now()) @map("last_at") @db.Timestamptz(6)

  @@id([visitor, month])
  @@map("guest_searches")
}

model ApiUsage {
  provider String   @db.VarChar(40)
  month    DateTime @db.Date
  calls    Int      @default(0)

  @@id([provider, month])
  @@map("api_usage")
}

// the Open Library cover of each US edition, found once and kept. A null
// coverId means the edition has none; those are looked at again monthly
model EditionCover {
  isbn13            String    @id @db.Char(13)
  coverId           Int?      @map("cover_id")
  checkedAt         DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)
  // Google Books' cover when Open Library has none (covers.ts fallbackCover);
  // a check time with no url: Google had none either
  fallbackUrl       String?   @map("fallback_url")
  fallbackCheckedAt DateTime? @map("fallback_checked_at") @db.Timestamptz(6)

  @@map("edition_covers")
}

// ---------- Canadian prices (sandboxed: see src/prices/canada) ----------

// when a volume's Canadian prices were last checked
model CaPriceCheck {
  isbn13    String   @id @db.Char(13)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("ca_price_checks")
}

// every Canadian price seen, in Canadian dollars
model CaPriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("CAD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  // the source group that found it: ebay (eBay.ca's API) or shopping
  source     String?  @db.VarChar(20)

  @@index([isbn13, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("ca_price_samples")
}

// each Canadian source group's last look at a volume, as price_source_checks
// is for the US
model CaPriceSourceCheck {
  isbn13    String   @db.Char(13)
  source    String   @db.VarChar(20)
  checkedAt DateTime @map("checked_at") @db.Timestamptz(6)

  @@id([isbn13, source])
  @@map("ca_price_source_checks")
}

// ---------- after the anime (see src/prices/afterAnime) ----------

// what MangaUpdates says about where a series' anime starts and ends, as it
// wrote it; read into seasons each time it's asked for (animeLines.ts), so a
// better reader needs no refetch. A series it doesn't know, or that has no
// anime, is kept too, with both lines null. Keyed like series_info
model AnimeStops {
  slug        String   @id @db.VarChar(80)
  // the series' own name, for the list of every show
  name        String   @db.VarChar(300)
  startLine   String?  @map("start_line")
  endLine     String?  @map("end_line")
  // the manga's latest chapter and whether it's finished, to tell when the
  // anime has adapted all of it
  lastChapter Int?     @map("last_chapter")
  completed   Boolean  @default(false)
  // its page on MangaUpdates, for the credit
  sourceUrl   String?  @map("source_url")
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("anime_stops")
}

// a reader's correction to where a season ends. Shown only once accepted
// (status), and then it replaces what MangaUpdates says for that season
model AnimeFix {
  id        Int       @id @default(autoincrement())
  slug      String    @db.VarChar(80)
  name      String    @db.VarChar(300)
  // the season it's about, as the page names it: "Season 2"
  label     String    @db.VarChar(60)
  // the last chapter the season adapts, and the volume to start from
  chapter   Float?
  volume    Int?
  // where they read it, and anything they want to add
  source    String    @db.VarChar(500)
  note      String?   @db.VarChar(500)
  // "pending", "accepted" or "rejected"
  status    String    @default("pending") @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)

  @@index([slug, status])
  @@index([status, createdAt])
  @@map("anime_fixes")
}

// A reader's review of one volume: a rating from 1 to 5 and a few words.
// Only someone who owns or has read the volume can write one
// (reviews/reviewRules.ts), and one each
model VolumeReview {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // the book it's of. Null for a volume we have no book for: that review
  // is kept by its series and number until a book for it turns up
  isbn13     String?      @db.Char(13)
  // the volume's series and number, for a series' page to add them up
  seriesSlug String       @map("series_slug") @db.VarChar(80)
  volume     Float?
  rating     Int          @db.SmallInt
  // the words; empty for a rating alone
  body       String       @default("") @db.VarChar(500)
  // hidden behind a tap: the writer said so, or enough readers did
  spoiler    Boolean      @default(false)
  // "shown", or "hidden" once enough readers have reported it (until the
  // site's owner keeps or removes it)
  status     String       @default("shown") @db.VarChar(10)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  flags      ReviewFlag[]

  @@unique([userId, isbn13])
  @@index([isbn13, status])
  @@index([seriesSlug, status])
  @@index([userId, seriesSlug])
  @@map("volume_reviews")
}

// another reader's flag on a review: "spoiler" or "report". One of each kind
// from a reader
model ReviewFlag {
  id        Int          @id @default(autoincrement())
  reviewId  Int          @map("review_id")
  review    VolumeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId    Int          @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind      String       @db.VarChar(10)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reviewId, userId, kind])
  @@map("review_flags")
}

// A shelf's dated history, for the year in manga: written by a database
// trigger whenever a series' volumes, chapter, volume read or finished
// changes (migration 20261209000000_shelf_history, which lists the kinds)
model ShelfEvent {
  id      BigInt   @id @default(autoincrement())
  userId  Int      @map("user_id")
  mangaId Int?     @map("manga_id")
  series  String   @db.VarChar(200)
  kind    String   @db.VarChar(20)
  volume  Float?
  amount  Int      @default(1)
  at      DateTime @default(now()) @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga?   @relation(fields: [mangaId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@map("shelf_events")
}

// Following another reader's shared shelf (Friends): shown only while their
// sharing is on (migration 20261211000000_shelf_follows)
model ShelfFollow {
  followerId Int      @map("follower_id")
  ownerId    Int      @map("owner_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  owner      User     @relation("followed", fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([followerId, ownerId])
  @@index([ownerId])
  @@map("shelf_follows")
}

// One reader blocking another: the blocked reader's reviews aren't shown to
// them, and neither can follow or open the other's shared shelf
// (src/blocks/blocks.ts). Only the blocker sees it, in Settings
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// a reader saying an omnibus or deluxe book exists that no catalog lists
// ("Missing a book?" on the editions page). It counts once three readers say
// the same, or the site's owner approves it (util/shelf/editionReports.ts)
model EditionReport {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the series, as its name compares (stores/match.ts seriesOf, with no
  // list version: util/shelf/editionReports.ts reportKey), and its name
  series    String   @db.VarChar(200)
  name      String   @db.VarChar(300)
  // the line's key ("vizbig", "deluxe") and the book's number in it
  edition   String   @db.VarChar(20)
  number    Int
  // the series' volumes they say it holds
  volumes   Int[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, series, edition, number])
  @@index([series])
  @@map("edition_reports")
}

// the site's owner on a reported book: "approved" makes it count at once,
// "rejected" keeps it out however many readers report it
model EditionDecision {
  series    String   @db.VarChar(200)
  edition   String   @db.VarChar(20)
  number    Int
  status    String   @db.VarChar(10)
  // the volumes it holds, as approved
  volumes   Int[]
  decidedAt DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  @@id([series, edition, number])
  @@map("edition_decisions")
}

// ---------- trusted books ----------

// Books we know for certain are the printed English book they say, from a
// source better than the free catalogs: a collector's hand-kept list first
// (scripts/loadTrustedBooks.ts loads any such file). A series' list takes a
// volume from here where the catalogs had none, or gave an ISBN no store
// has ever priced (prices/trustedBooks.ts); a scan of one is known at once
model TrustedBook {
  isbn13      String   @id @db.Char(13)
  isbn10      String?  @db.Char(10)
  // where it came from ("collector-viz"), so a source can be taken out
  // whole, and how far it's trusted: 3 a hand-checked list, 2 three readers
  // agreeing, 1 found automatically. A lower one never replaces a higher
  source      String   @db.VarChar(40)
  trust       Int      @db.SmallInt
  // the series, as the source names it and as names compare (stores/match.ts
  // seriesOf), and what kind of book: single, edition, novel or oneshot
  series      String   @db.VarChar(200)
  seriesKey   String   @map("series_key") @db.VarChar(200)
  kind        String   @db.VarChar(10)
  // its volume number (single, novel), or the volumes an edition book holds
  volume      Float?
  holds       Int[]    @default([])
  title       String   @db.VarChar(300)
  publisher   String?  @db.VarChar(120)
  // its English release date ("2013-03-12"), page count, the publisher's
  // description, and its list price, when the source says
  published   String?  @db.VarChar(10)
  pages       Int?
  description String?
  listCents   Int?     @map("list_cents")
  // the source marks it the series' last volume in English ("(Complete)",
  // "(Final)"): "Complete in English" when the list ends there too
  ends        Boolean  @default(false)
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  @@index([seriesKey])
  @@map("trusted_books")
}

// An ISBN a series' list gave before a trusted book took its place: kept so
// an old address, a To buy item or a review on it follows to the new one
// (prices/trustedBooks.ts recordSwaps)
model IsbnSwap {
  fromIsbn  String   @id @map("from_isbn") @db.Char(13)
  toIsbn    String   @map("to_isbn") @db.Char(13)
  seriesKey String   @map("series_key") @db.VarChar(200)
  volume    Float
  source    String   @db.VarChar(40)
  swappedAt DateTime @default(now()) @map("swapped_at") @db.Timestamptz(6)

  @@index([toIsbn])
  @@map("isbn_swaps")
}

// A reader's book that says which volume an ISBN is: a barcode they scanned
// onto a series, or a file they imported. Once three readers' accounts (a
// week old or more) agree, and one of them scanned it, the ISBN becomes a
// trusted book (source "readers", trust 2): prices/readerBooks.ts. An
// import alone never does it, since a file's ISBN can be an ebook's
model IsbnSighting {
  userId    Int      @map("user_id")
  isbn13    String   @db.Char(13)
  seriesKey String   @map("series_key") @db.VarChar(200)
  series    String   @db.VarChar(200)
  kind      String   @db.VarChar(10)
  volume    Float
  // "scan" or "import"
  how       String   @db.VarChar(10)
  seenAt    DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, isbn13])
  @@index([isbn13])
  @@map("isbn_sightings")
}

// What a catalog says of one book, for its page: the publisher's
// description, page count and release date. Kept from Google Books' answers
// to the searches the site makes anyway, and filled slowly for the rest (a
// few lookups a day: prices/volumeDetails.ts). A row with nothing in it is
// a book that was asked about and has none, so it isn't asked again. A
// trusted source's own (trusted_books) comes first on the page
model VolumeDetail {
  isbn13      String   @id @db.Char(13)
  description String?
  pages       Int?
  // "2019-11-12", or "2019-11" when only the month is known
  published   String?  @db.VarChar(10)
  source      String   @db.VarChar(20)
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("volume_details")
}
