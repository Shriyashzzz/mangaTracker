// Mapped onto the tables the JS version made with raw SQL (models/initdb.js,
// initPrices.js, migrate.js), so an existing database is used as it is:
// run `npm run db:baseline` once against it instead of migrating.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- the shelf ----------

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(40)
  password String
  // display preferences: { background, theme }
  prefs    Json    @default("{}")
  // what others see if they share their list; the username stays private
  displayName   String? @map("display_name") @db.VarChar(40)
  avatar        String? @db.VarChar(20)
  // optional, set in settings. Nothing sends to it yet
  recoveryEmail String? @map("recovery_email") @db.VarChar(254)
  // the link is a random code, and stays the same if sharing is switched off and on
  shareEnabled  Boolean @default(false) @map("share_enabled")
  shareNotes    Boolean @default(false) @map("share_notes")
  shareCode     String? @unique @map("share_code") @db.VarChar(16)
  manga    Manga[]

  @@map("users")
}

model Manga {
  id           Int     @id @default(autoincrement())
  userId       Int?    @map("user_id")
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name         String
  genre        String? @db.VarChar(100)
  description  String?
  image        String?
  // true = finished reading
  status       Boolean @default(false)
  // on their To read list: not started yet. Never true alongside status
  planned      Boolean @default(false)
  // a light novel rather than a manga: no manga prices or volume news for it
  lightNovel   Boolean @default(false) @map("light_novel")
  // the chapter they're on
  bookmark     Int?
  // the last volume they own ("up to Vol. 14"); null when they don't say
  volumesOwned Int?    @map("volumes_owned") @db.SmallInt
  rating       Int?    @db.SmallInt
  // the newest release they've said "Seen it" to; anything newer shows as new
  seenVolume      Float? @map("seen_volume")
  seenChapter     Float? @map("seen_chapter")
  seenJapanVolume Float? @map("seen_japan_volume")
  // volumes hidden one at a time, on top of everything up to seenVolume
  hiddenVolumes   Float[] @default([]) @map("hidden_volumes")
  // the latest chapter last found for this series; updated by each lookup
  latestChapter   Float?  @map("latest_chapter")

  @@index([userId])
  @@map("manga")
}

// express-session's store (connect-pg-simple). Kept in the schema so
// migrations never try to drop it
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------- the price checker ----------

model Book {
  isbn13    String        @id @db.Char(13)
  title     String
  authors   String?
  publisher String?
  coverUrl  String?       @map("cover_url")
  year      Int?          @db.SmallInt
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  samples   PriceSample[]
  check     PriceCheck?

  @@map("books")
}

// every price we ever fetch, so we can show the latest offers and the history
model PriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  book       Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("USD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([isbn13, fetchedAt(sort: Desc)], map: "price_samples_isbn_time")
  @@map("price_samples")
}

// when each volume was last checked, even if no store had it
model PriceCheck {
  isbn13    String   @id @db.Char(13)
  book      Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("price_checks")
}

// AniList series info, cached a week per series
model SeriesInfo {
  slug      String   @id @db.VarChar(80)
  info      Json?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_info")
}

// the last good list of a series' volumes, so a restart or an Open Library outage
// doesn't empty the page. Keyed by the normalized series name
model SeriesVolumes {
  key       String   @id @db.VarChar(200)
  volumes   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_volumes")
}

// what MangaDex said about a series' releases, kept 6 hours (util/releaseCache.ts)
model ReleaseDates {
  slug      String   @id @db.VarChar(160)
  data      Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("release_dates")
}

// paid APIs with a monthly allowance: how many calls we've made this month
model ApiUsage {
  provider String   @db.VarChar(40)
  month    DateTime @db.Date
  calls    Int      @default(0)

  @@id([provider, month])
  @@map("api_usage")
}

// the Open Library cover of each US edition, found once and kept. A null
// coverId means the edition has none; those are looked at again monthly
model EditionCover {
  isbn13    String   @id @db.Char(13)
  coverId   Int?     @map("cover_id")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("edition_covers")
}

// ---------- Canadian prices (sandboxed: see src/prices/canada) ----------

// when a volume's Canadian prices were last checked
model CaPriceCheck {
  isbn13    String   @id @db.Char(13)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("ca_price_checks")
}

// every Canadian price seen, in Canadian dollars
model CaPriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("CAD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([isbn13, fetchedAt(sort: Desc)])
  @@map("ca_price_samples")
}
