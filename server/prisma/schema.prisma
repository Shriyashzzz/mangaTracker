// Mapped onto the tables the JS version made with raw SQL (models/initdb.js,
// initPrices.js, migrate.js), so an existing database is used as it is:
// run `npm run db:baseline` once against it instead of migrating.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- the shelf ----------

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(40)
  password String
  // display preferences: { background, theme }
  prefs    Json    @default("{}")
  // what others see if they share their list; the username stays private
  displayName   String? @map("display_name") @db.VarChar(40)
  avatar        String? @db.VarChar(20)
  // optional, set in settings. Nothing sends to it yet
  recoveryEmail String? @map("recovery_email") @db.VarChar(254)
  // the link is a random code, and stays the same if sharing is switched off and on
  shareEnabled  Boolean @default(false) @map("share_enabled")
  shareNotes    Boolean @default(false) @map("share_notes")
  shareCode     String? @unique @map("share_code") @db.VarChar(16)
  // series on their shelf, kept right by a database trigger on manga
  // (migration 20261113000000_search_tracking); never written from code
  mangaCount      Int @default(0) @map("manga_count")
  // SerpApi searches their visits have spent (prices/spender.ts)
  serpapiSearches Int @default(0) @map("serpapi_searches")
  manga    Manga[]

  @@map("users")
}

model Manga {
  id           Int     @id @default(autoincrement())
  userId       Int?    @map("user_id")
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name         String
  genre        String? @db.VarChar(100)
  description  String?
  image        String?
  // true = finished reading
  status       Boolean @default(false)
  // on their To read list: not started yet. Never true alongside status
  planned      Boolean @default(false)
  // a light novel rather than a manga: no manga prices or volume news for it
  lightNovel   Boolean @default(false) @map("light_novel")
  // the chapter they're on
  bookmark     Int?
  // the last volume they own ("up to Vol. 14"); null when they don't say
  volumesOwned Int?    @map("volumes_owned") @db.SmallInt
  // the exact volumes they own, when it isn't a run from 1 (One Piece 1 and 4);
  // empty means 1 to volumesOwned. volumesOwned is its highest
  // (util/shelf/ownedList.ts)
  ownedList    Float[] @default([]) @map("owned_list")
  rating       Int?    @db.SmallInt
  // the newest release they've said "Seen it" to; anything newer shows as new
  seenVolume      Float? @map("seen_volume")
  seenChapter     Float? @map("seen_chapter")
  seenJapanVolume Float? @map("seen_japan_volume")
  // volumes hidden one at a time, on top of everything up to seenVolume
  hiddenVolumes   Float[] @default([]) @map("hidden_volumes")
  // the latest chapter last found for this series; updated by each lookup
  latestChapter   Float?  @map("latest_chapter")

  // the last release check's answer, so the New tab can open without asking
  // every other site again (ReleaseAnswer)
  releaseAnswer ReleaseAnswer?

  @@index([userId])
  @@map("manga")
}

// express-session's store (connect-pg-simple). Kept in the schema so
// migrations never try to drop it
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ---------- the price checker ----------

model Book {
  isbn13    String        @id @db.Char(13)
  title     String
  authors   String?
  publisher String?
  coverUrl  String?       @map("cover_url")
  year      Int?          @db.SmallInt
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  samples   PriceSample[]
  check     PriceCheck?
  // each price source group's last look (prices/service.ts)
  sourceChecks PriceSourceCheck[]

  @@map("books")
}

// every price we ever fetch, so we can show the latest offers and the history
model PriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  book       Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("USD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  // the source group that found it: ebay, shopping, amazon, ebooks, walmart
  source     String?  @db.VarChar(20)

  @@index([isbn13, fetchedAt(sort: Desc)], map: "price_samples_isbn_time")
  @@map("price_samples")
}

// when each volume was last checked, even if no store had it
model PriceCheck {
  isbn13    String   @id @db.Char(13)
  book      Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("price_checks")
}

// each source group's last look at a volume; its prices are the samples it
// saved at that moment. Each group checks on its own schedule
model PriceSourceCheck {
  isbn13    String   @db.Char(13)
  book      Book     @relation(fields: [isbn13], references: [isbn13], onDelete: Cascade, onUpdate: NoAction)
  source    String   @db.VarChar(20)
  checkedAt DateTime @map("checked_at") @db.Timestamptz(6)

  @@id([isbn13, source])
  @@map("price_source_checks")
}

// AniList series info, cached a week per series
model SeriesInfo {
  slug      String   @id @db.VarChar(80)
  info      Json?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_info")
}

// the last good list of a series' volumes, so a restart or an Open Library outage
// doesn't empty the page. Keyed by the normalized series name
model SeriesVolumes {
  key       String   @id @db.VarChar(200)
  volumes   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("series_volumes")
}

// whether a manga's series has a light novel in the catalog that AniList doesn't
// list (Solo Leveling's): checked in the background the first time the series
// comes up in a search, then again after a month (see prices/novelFinder.ts).
// Keyed like series_volumes, by the normalized series name
model NovelCheck {
  key       String   @id @db.VarChar(200)
  // the novel's series name as the catalog sells it, which can differ from
  // the manga's ("Omniscient Reader's Viewpoint Light Novel" for Omniscient
  // Reader); null when there's no novel
  name      String?  @db.VarChar(200)
  // how many novel volumes were found; 0 when there's no novel
  volumes   Int      @default(0)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("novel_checks")
}

// what an imported book title is on AniList, shared by everyone's imports so
// each one is faster than the last (util/shelf/sharedMatches.ts). Only real
// matches, each checked by the server against AniList before it's kept; the
// title is kept only as a hash. Filled ahead too (scripts/seedImportMatches.ts)
model ImportMatch {
  // sha256 of the search as the import asks it: format, exact-only, title
  key       String   @id @db.Char(64)
  anilistId Int      @map("anilist_id")
  malId     Int?     @map("mal_id")
  name      String   @db.VarChar(300)
  cover     String?
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("import_matches")
}

// what MangaDex said about a series' releases, kept 6 hours (util/releaseCache.ts)
// a manga's last release check, as its answer was sent: the New tab asks for
// a whole shelf of these at once rather than one site call per series. Kept
// only while key (what the answer depended on: the series, how far they are,
// what they've hidden, their release settings) still matches, and for hours
model ReleaseAnswer {
  mangaId   Int      @id @map("manga_id")
  key       String
  answer    Json
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@map("release_answers")
}

model ReleaseDates {
  slug      String   @id @db.VarChar(160)
  data      Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("release_dates")
}

// paid APIs with a monthly allowance: how many calls we've made this month
// SerpApi searches spent by visitors who aren't signed in, one row per
// visitor a month. visitor hashes their IP and browser with the server
// secret; no IP is stored (prices/spender.ts)
model GuestSearch {
  visitor   String   @db.Char(16)
  month     DateTime @db.Date
  searches  Int      @default(0)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  lastAt    DateTime @default(now()) @map("last_at") @db.Timestamptz(6)

  @@id([visitor, month])
  @@map("guest_searches")
}

model ApiUsage {
  provider String   @db.VarChar(40)
  month    DateTime @db.Date
  calls    Int      @default(0)

  @@id([provider, month])
  @@map("api_usage")
}

// the Open Library cover of each US edition, found once and kept. A null
// coverId means the edition has none; those are looked at again monthly
model EditionCover {
  isbn13    String   @id @db.Char(13)
  coverId   Int?     @map("cover_id")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("edition_covers")
}

// ---------- Canadian prices (sandboxed: see src/prices/canada) ----------

// when a volume's Canadian prices were last checked
model CaPriceCheck {
  isbn13    String   @id @db.Char(13)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  sources   String[] @default([])

  @@map("ca_price_checks")
}

// every Canadian price seen, in Canadian dollars
model CaPriceSample {
  id         BigInt   @id @default(autoincrement())
  isbn13     String   @db.Char(13)
  store      String   @db.VarChar(60)
  format     String   @default("print") @db.VarChar(20)
  condition  String   @default("new") @db.VarChar(20)
  priceCents Int      @map("price_cents")
  currency   String   @default("CAD") @db.Char(3)
  inStock    Boolean  @default(true) @map("in_stock")
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([isbn13, fetchedAt(sort: Desc)])
  @@map("ca_price_samples")
}
